# Variables de entorno del backend de TodoCasa.
# Copiá este archivo a .env y completá los valores. No subas nunca el .env a git.
# (OBLIGATORIA) = el backend no arranca o no funciona sin ella.

# --- Base de datos (Prisma / PostgreSQL) ---
# (OBLIGATORIA) Cadena de conexión que usa la aplicación (puede ser la del pooler).
DATABASE_URL=
# (OBLIGATORIA) Conexión directa, sin pooler. La usa Prisma para migraciones.
DIRECT_URL=

# --- Autenticación (JWT) ---
# (OBLIGATORIA) Clave para firmar los tokens de acceso. Con NODE_ENV=production, al menos 32 caracteres.
JWT_SECRET=
# (OBLIGATORIA) Clave para firmar los refresh tokens. Distinta de JWT_SECRET; con NODE_ENV=production, al menos 32 caracteres.
JWT_REFRESH_SECRET=
# Opcional. Duración del token de acceso (por defecto 900s).
JWT_EXPIRES_IN=
# Opcional. Duración del refresh token (por defecto 7d).
JWT_REFRESH_EXPIRES_IN=

# --- Servidor ---
# Opcional. Puerto HTTP (por defecto 3000; Render lo define solo).
PORT=
# Entorno: production en Render. Activa la exigencia de 32 caracteres en los secretos JWT.
NODE_ENV=
# (OBLIGATORIA para el panel web) Orígenes permitidos por CORS, separados por coma.
# Son las URLs del panel de administración, no la del backend. Ej: https://admin.ejemplo.com,http://localhost:3001
CORS_ORIGINS=

# --- Mercado Pago ---
# (OBLIGATORIA para cobrar) Access token de Mercado Pago.
MP_ACCESS_TOKEN=
# Opcional. Precio de la suscripción mensual en ARS (por defecto 11000).
SUSCRIPCION_PRECIO_ARS=
# Opcional. Precio de la verificación en ARS. Sin valor, el pago de verificación se rechaza.
VERIFICACION_PRECIO_ARS=
# Opcional. URL pública del front para las back_urls de Mercado Pago (se ignora si es localhost).
FRONT_URL=
# Opcional. URL pública de este backend; se usa para notification_url (webhook) de Mercado Pago.
BACK_URL=

# --- Google ---
# Opcional. Client ID de Google. Solo hace falta si se vuelve a habilitar el login con Google.
GOOGLE_CLIENT_ID=

# --- Script scripts/crear-admin.js (solo al ejecutarlo) ---
# Email del administrador a crear.
ADMIN_EMAIL=
# Contraseña del administrador (mínimo exigido por el script).
ADMIN_PASSWORD=
# Opcional. Nombre del administrador (por defecto "Administrador").
ADMIN_NOMBRE=
